{
  "name": "A2A customer support agent (Fusion showcase)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup python main.py > agent.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "A2A agent",
      "onAutoForward": "silent"
    }
  }
}
